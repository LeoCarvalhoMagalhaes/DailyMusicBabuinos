# Copie para backend/.env e ajuste. Nunca coloque credenciais reais no repositório.

# development | test | production
APP_ENV=development

# SQLite para desenvolvimento; PostgreSQL em produção
# (postgres://... e postgresql://... são convertidos para o driver psycopg automaticamente).
DATABASE_URL=sqlite:///./babuinos.db
# DATABASE_URL=postgresql://babuinos:babuinos@localhost:5432/babuinos

# Segredo do sorteio diário (obrigatório em produção, >= 32 caracteres).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
CHALLENGE_SECRET=dev-only-secret-troque-em-producao

# Fuso que define a virada do desafio e o número do desafio (#1 na data de lançamento).
CHALLENGE_TIMEZONE=America/Sao_Paulo
LAUNCH_DATE=2026-10-14

# Pistas (segundos) e pontuação por tentativa — mesmo tamanho nas duas listas.
CLIP_STAGES_SECONDS=0.5,1,2,4,8,16
SCORE_TABLE=100,80,60,40,20,10

# Controle de repetição na seleção diária.
REPEAT_WINDOW_DAYS=60
ARTIST_COOLDOWN_DAYS=7

# deezer = (padrão) trechos das gravações originais, a partir das prévias oficiais de 30 s
#          da API pública do Deezer; catálogo principal (músicas mais ouvidas no Spotify)
# local  = arquivos licenciados em AUDIO_LOCAL_DIR/<slug>.mp3|.wav (catálogo principal)
# demo   = modo offline: melodias em domínio público sintetizadas (sem rede)
AUDIO_PROVIDER=deezer
AUDIO_LOCAL_DIR=./audio-local
AUDIO_CACHE_TTL_SECONDS=600
AUDIO_CACHE_MAX_ITEMS=32
DEEZER_API_BASE=https://api.deezer.com
DEEZER_TIMEOUT_SECONDS=8

# Origens do frontend autorizadas (separadas por vírgula).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limites de requisição (por minuto; criação de jogador por hora).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GUESS_PER_MINUTE=30
RATE_LIMIT_SEARCH_PER_MINUTE=120
RATE_LIMIT_AUDIO_PER_MINUTE=60
RATE_LIMIT_PLAYERS_PER_HOUR=20

AUTO_SYNC_CATALOG=true
